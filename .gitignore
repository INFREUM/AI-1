# ==========================================
# INFREUM AI-1 | Python .gitignore
# ==========================================

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store
.AppleDouble

# Windows
Thumbs.db
Desktop.ini

# Jupyter Notebook
.ipynb_checkpoints/

# Python testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Build / packaging
build/
dist/
*.egg-info/

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
*.bak

# Local raw / private data
data/raw/
data/private/

# Local training outputs
outputs/
runs/
checkpoints/
wandb/
mlruns/
